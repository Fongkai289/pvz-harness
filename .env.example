# Copy to .env on the server and fill in. .env is never synced by scripts/deploy.ps1.

# Shared secret the client sends in its hello. Generate with: openssl rand -hex 24
PVZ_TOKEN=

# Slow layer: "mock", "qwen" (shared Qwen3.8-27B pool) or "claude" (needs ANTHROPIC_API_KEY).
PVZ_PLANNER=qwen
# true = the planner sees the screenshot; false = text-only, it reads the perception summary.
# The Qwen pool has accepted images since 2026-10-28 14:40 (relaunched without --language-model-only).
PVZ_PLANNER_SEND_IMAGE=true
# Screenshot only (harness ladder L1); true adds the perception summary text (L3).
PVZ_PLANNER_INCLUDE_SUMMARY=false
PVZ_PLANNER_TIMEOUT=60
PVZ_QWEN_URL=http://127.0.0.1:18201/v1/chat/completions
PVZ_QWEN_MODEL=Qwen3.8-27B
# ANTHROPIC_API_KEY=
PVZ_PLANNER_MODEL=claude-opus-5-5
PVZ_PLANNER_EFFORT=low

# Fast decider: "rules" or "onejev" (shared OneJev pool, text state only - never send it images).
# onejev selects plant+row and then column under planner guidance; errors/timeouts mean wait.
# rules is an explicit comparison baseline, not an automatic model-error fallback.
PVZ_DECIDER=onejev
# 27B bare decision API (2026-10-30); the retired 18200 pool returned no available workers.
# Explicit legacy alternative: 18202/v1/systemone with OneJev-0.8B.
PVZ_ONEJEV_URL=http://127.0.0.1:18220/v1/decide
PVZ_ONEJEV_MODEL=autotrust/JEV-27B-VL
PVZ_DECIDER_TIMEOUT=1.0
# Total timeout for both Jev selection batches; remeasure latency for the new selection task.

# Fallback intervals; explicit playbook.timing values take precedence for each session.
PVZ_LOOK_INTERVAL=4
PVZ_ZOMBIES_INTERVAL=4
PVZ_PLANTS_INTERVAL=4
PVZ_PLAN_INTERVAL=6
PVZ_FAST_INTERVAL=1.0

PVZ_HOST=127.0.0.1
PVZ_PORT=8765
PVZ_FRAME_LOG_INTERVAL=4.0
PVZ_MAX_RUN_BYTES=2147483648
# New confirmed real-game reviews enqueue the independent Windows pvz_rl worker.
# Requires compatible retail game and scripts/native_rsi.ps1 -Mode Watch.
PVZ_AUTO_NATIVE_RSI=true
PVZ_NATIVE_EVOLUTION=code

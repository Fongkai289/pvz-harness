diff --git a/tools/harness_benchmark.py b/tools/harness_benchmark.py
new file mode 100644
index 0000000..d7c5f50
--- /dev/null
+++ b/tools/harness_benchmark.py
@@ -0,0 +1,162 @@
+"""Real Portable engine benchmark. WAIT only; not training or a promotion result."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import queue
+import subprocess
+import threading
+import time
+
+
+def checksum(value):
+    return hashlib.sha256(json.dumps(value,sort_keys=True).encode()).hexdigest()
+
+
+class Engine:
+    def __init__(self,exe,resources,root,runtime_bin=None):
+        self.root=root
+        self.log=(root/'engine.log').open('w',encoding='utf-8')
+        self.queue=queue.Queue()
+        env={**os.environ,'PVZ_HARNESS':'1','SDL_AUDIODRIVER':'dummy'}
+        if runtime_bin: env['PATH']=str(runtime_bin)+os.pathsep+env['PATH']
+        # Keep all profile/cache writes in the experiment's private directory.
+        args=[str(exe),'-resdir',str(resources),'-savedir',str(root/'save')]
+        self.process=subprocess.Popen(args,stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=self.log,
+            text=True,encoding='utf-8',errors='replace',env=env,cwd=root,
+            creationflags=getattr(subprocess,'CREATE_NO_WINDOW',0))
+        def read():
+            for line in self.process.stdout:
+                if line.startswith('PVZRPC '):
+                    self.queue.put(json.loads(line[7:]))
+                else:
+                    self.log.write(line); self.log.flush()
+            self.queue.put(None)
+        self.reader=threading.Thread(target=read,daemon=True); self.reader.start()
+        try:
+            ready=self.response(180)
+            if not ready.get('ready'): raise RuntimeError('engine not ready')
+        except BaseException:
+            self.close(); raise
+
+    def response(self,timeout=20):
+        try: result=self.queue.get(timeout=timeout)
+        except queue.Empty: raise TimeoutError('Portable response timeout')
+        if result is None:
+            code=self.process.wait(timeout=5)
+            raise RuntimeError(f'Portable exited: {code}; see {self.root}/engine.log')
+        if not result.get('ok'): raise ValueError(result.get('error'))
+        return result
+
+    def call(self,command):
+        self.process.stdin.write(command+'\n'); self.process.stdin.flush()
+        return self.response()
+
+    def close(self):
+        if self.process.poll() is None:
+            try:
+                self.process.stdin.write('quit\n'); self.process.stdin.flush()
+                self.process.wait(timeout=8)
+            except (OSError,subprocess.TimeoutExpired):
+                self.process.kill(); self.process.wait(timeout=5)
+        self.reader.join(timeout=3)
+        for stream in (self.process.stdin,self.process.stdout,self.log):
+            try: stream.close()
+            except OSError: pass
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--exe',type=Path,required=True)
+    p.add_argument('--resources',type=Path,required=True)
+    p.add_argument('--output',type=Path,required=True)
+    p.add_argument('--episodes',type=int,default=20)
+    args=p.parse_args()
+    root=args.output.resolve(); root.mkdir(parents=True,exist_ok=False)
+    report=dict(kind='engine_only_wait_baseline',model_calls=0,training=False,episodes=[],
+        executable_sha256=hashlib.sha256(args.exe.read_bytes()).hexdigest())
+    startup=time.perf_counter()
+    engine=Engine(args.exe.resolve(),args.resources.resolve(),root)
+    report['startup_wall_s']=time.perf_counter()-startup
+    print(json.dumps(dict(ready=True,startup_wall_s=report['startup_wall_s'])),flush=True)
+    try:
+        # Replay identical wait actions from the same seed after a different reset.
+        samples=[]
+        replay_states=[]
+        for seed in (424242,81723,424242):
+            state=engine.call(f'reset 4 {seed}')
+            assert state['tick']==0 and state['level']==4 and not state['terminal']
+            path=[checksum(state)]
+            states=[state]
+            for _ in range(12):
+                state=engine.call('step 1000 -1 0 0'); path.append(checksum(state))
+                states.append(state)
+                if state['terminal']: break
+            samples.append(path)
+            replay_states.append(dict(seed=seed,states=states))
+        (root/'replay-check.json').write_text(json.dumps(replay_states,indent=2),encoding='utf-8')
+        report['same_seed_replay_equal']=samples[0]==samples[2]
+        report['different_seed_changes_trace']=samples[0]!=samples[1]
+        if not report['same_seed_replay_equal']:
+            raise RuntimeError('same-seed reset is not deterministic')
+        # Invalid placements must not consume resources or advance game time.
+        before=engine.call('reset 4 31000')
+        time.sleep(.05)
+        assert before==engine.call('state')
+        report['game_frozen_between_commands']=True
+        try: engine.call('step 25 99 0 0')
+        except ValueError as exc: assert str(exc)=='invalid_action_bounds'
+        else: raise AssertionError('invalid placement accepted')
+        assert before==engine.call('state')
+        report['invalid_action_rejected_without_mutation']=True
+        started=time.perf_counter()
+        for index in range(args.episodes):
+            seed=50000+index
+            ep_start=time.perf_counter()
+            state=engine.call(f'reset 4 {seed}')
+            reset_s=time.perf_counter()-ep_start
+            initial=state
+            snapshots=0
+            while not state['terminal'] and state['tick']<60000:
+                previous=state['tick']
+                state=engine.call('step 200 -1 0 0')
+                assert previous<state['tick']<=previous+200
+                snapshots+=1
+            if not state['terminal']: raise RuntimeError('episode truncated at 600 game seconds')
+            result=dict(index=index+1,level=4,seed=seed,outcome=state['outcome'],game_seconds=state['tick']/100,
+                        wall_s=time.perf_counter()-ep_start,reset_wall_s=reset_s,observations=snapshots,
+                        initial_sun=initial['sun'],final=state)
+            report['episodes'].append(result)
+            (root/f'episode-{index+1:02d}.json').write_text(json.dumps(result,indent=2),encoding='utf-8')
+            print(json.dumps({k:v for k,v in result.items() if k!='final'}),flush=True)
+        report['batch_wall_s']=time.perf_counter()-started
+        report['measured_games_per_hour']=len(report['episodes'])*3600/report['batch_wall_s']
+        report['game_seconds_per_wall_second']=sum(e['game_seconds'] for e in report['episodes'])/report['batch_wall_s']
+        # Complete-game replay after losses, with wall-clock pauses in one run.
+        # Excluded from the timed 20-game batch above.
+        full_paths=[]
+        for replay in range(2):
+            state=engine.call('reset 4 50000')
+            path=[checksum(state)]
+            while not state['terminal'] and state['tick']<60000:
+                if replay==1 and state['tick']%4000==0: time.sleep(.02)
+                state=engine.call('step 200 -1 0 0'); path.append(checksum(state))
+            assert state['terminal']
+            full_paths.append(path)
+        report['full_episode_replay_equal_after_losses_and_pauses']=full_paths[0]==full_paths[1]
+        if full_paths[0]!=full_paths[1]: raise RuntimeError('full episode replay diverged')
+        (root/'full-replay-check.json').write_text(json.dumps(full_paths,indent=2),encoding='utf-8')
+        report['status']='passed'
+    except BaseException as exc:
+        report.update(status='failed',error=f'{type(exc).__name__}: {exc}')
+        raise
+    finally:
+        engine.close()
+        report['engine_exit_code']=engine.process.returncode
+        if report['engine_exit_code']!=0: report.update(status='failed',error='nonzero engine exit')
+        (root/'report.json').write_text(json.dumps(report,indent=2),encoding='utf-8')
+    print(json.dumps({k:v for k,v in report.items() if k!='episodes'}),flush=True)
+
+
+if __name__=='__main__': main()

diff --git a/src/Harness.cpp b/src/Harness.cpp
new file mode 100644
index 0000000..2fcc939
--- /dev/null
+++ b/src/Harness.cpp
@@ -0,0 +1,305 @@
+// Local experimental adapter. SPDX-License-Identifier: LGPL-3.0-or-later
+// Never opens a network port or drives the desktop. Only an owned stdin pipe.
+#include "LawnApp.h"
+#include "Lawn/Board.h"
+#include "Lawn/Cutscene.h"
+#include "Lawn/SeedPacket.h"
+#include "Lawn/System/PlayerInfo.h"
+#include "Lawn/System/ProfileMgr.h"
+#include "Lawn/System/Music.h"
+#include "Lawn/Widget/SeedChooserScreen.h"
+#include "SexyAppFramework/graphics/MemoryImage.h"
+#include "SexyAppFramework/graphics/Graphics.h"
+#include "PvzpLib/EffectSystem.h"
+#include "SexyAppFramework/Common.h"
+#include <SDL.h>
+#include <algorithm>
+#include <array>
+#include <cstdlib>
+#include <iostream>
+#include <fstream>
+#include <filesystem>
+#include <sstream>
+#include <stdexcept>
+#include <vector>
+
+namespace Sexy {
+std::string HarnessSaveRand();
+void HarnessRestoreRand(const std::string& state);
+}
+
+namespace {
+std::array<int, 6> mowerTicks;
+int startTick = 0;
+bool Done(LawnApp& a) {
+    return a.mBoard && (a.mBoardResult == BOARDRESULT_LOST || a.mBoard->mLevelAwardSpawned || a.mBoard->mLevelComplete);
+}
+void Tick(LawnApp& a) {
+    a.mBoard->ProcessDeleteQueue();
+    a.mEffectSystem->ProcessDeleteQueue();
+    ++a.mAppCounter;
+    ++a.mUpdateCount;
+    a.mBoard->Update();
+    // Native automatic sun collection, independent of planting decisions.
+    for (auto* c : a.mBoard->mCoins)
+        if (!c->mDead && c->IsSun() && !c->mIsBeingCollected) c->Collect();
+    for (auto* m : a.mBoard->mLawnMowers)
+        if (m->mMowerState == MOWER_TRIGGERED && m->mRow >= 0 && m->mRow < 6 && mowerTicks[m->mRow] < 0)
+            mowerTicks[m->mRow] = a.mBoard->mMainCounter - startTick;
+}
+void Snapshot(LawnApp& a) {
+    auto& b = *a.mBoard;
+    std::ostringstream o;
+    o << std::boolalpha;
+    o << "{\"ok\":true,\"level\":" << b.mLevel << ",\"tick\":" << b.mMainCounter-startTick
+      << ",\"sun\":" << b.mSunMoney << ",\"wave\":" << b.mCurrentWave << ",\"waves\":" << b.mNumWaves
+      << ",\"conveyor\":" << b.HasConveyorBeltSeedBank() << ",\"shovel\":" << (b.mShowShovel && !Done(a))
+      << ",\"terminal\":" << Done(a) << ",\"outcome\":\""
+      << (a.mBoardResult == BOARDRESULT_LOST ? "lose" : Done(a) ? "win" : "running") << "\",\"plants\":[";
+    bool comma = false;
+    for (auto* p : b.mPlants) if (!p->mDead) {
+        if (comma) o << ','; comma = true;
+        o << "{\"type\":" << p->mSeedType << ",\"row\":" << p->mRow << ",\"col\":" << p->mPlantCol << '}';
+    }
+    o << "],\"zombies\":["; comma = false;
+    for (auto* z : b.mZombies) if (!z->mDead) {
+        if (comma) o << ','; comma = true;
+        o << "{\"type\":" << z->mZombieType << ",\"row\":" << z->mRow << ",\"x\":" << z->mPosX
+          << ",\"phase\":" << z->mZombiePhase << '}';
+    }
+    o << "],\"cards\":[";
+    for (int i=0; i<b.mSeedBank->mNumPackets; ++i) {
+        auto& c = b.mSeedBank->mSeedPackets[i];
+        if (i) o << ',';
+        o << "{\"slot\":" << i << ",\"type\":" << c.mPacketType << ",\"ready\":" << (c.mActive && c.mPacketType!=SEED_NONE)
+          << ",\"cost\":" << (b.HasConveyorBeltSeedBank() ? 0 : b.GetCurrentPlantCost(c.mPacketType,c.mImitaterType)) << '}';
+    }
+    o << "],\"mower_ticks\":[";
+    for (int i=0; i<6; ++i) { if (i) o << ','; o << mowerTicks[i]; }
+    o << "],\"allowed\":["; comma = false;
+    if (!Done(a)) for (int s=0; s<b.mSeedBank->mNumPackets; ++s) {
+        auto& c = b.mSeedBank->mSeedPackets[s];
+        if (!c.CanPickUp()) continue;
+        for (int r=0; r<5; ++r) for (int col=0; col<9; ++col)
+            if (b.CanPlantAt(col,r,c.mPacketType)==PLANTING_OK) {
+                if (comma) o << ','; comma = true;
+                o << '[' << s << ',' << r << ',' << col << ']';
+            }
+    }
+    o << "]}";
+    std::cout << "PVZRPC " << o.str() << std::endl;
+}
+unsigned pendingSeed = 0;  // between "prepare" (stopped at the seed chooser) and "choose"
+bool atChooser = false;
+void BeginReset(LawnApp& a, int level, unsigned seed) {
+    // First area only; do not silently skip unsupported night/pool/roof rules.
+    if (level < 1 || level > 10) throw std::runtime_error("unsupported_level");
+    atChooser = false;
+    std::cerr << "harness reset: deleting previous board" << std::endl;
+    a.KillBoard();
+    a.ProcessSafeDeleteList();
+    a.mEffectSystem->ProcessDeleteQueue();
+    a.mPlayerInfo->mLevel = level;
+    a.mPlayerInfo->mFinishedAdventure = 0;
+    a.mAppRandSeed = seed;
+    a.mAppCounter = 0;
+    a.mUpdateCount = 0;
+    a.mBoardResult = BOARDRESULT_NONE;
+    Sexy::SRand(seed);
+    std::srand(seed);
+    mowerTicks.fill(-1);
+    startTick = 0;
+    std::cerr << "harness reset: creating board" << std::endl;
+    if (a.mTitleScreen) a.FastLoad(GAMEMODE_ADVENTURE);
+    else a.PreNewGame(GAMEMODE_ADVENTURE,false);
+    a.ProcessSafeDeleteList();
+    std::cerr << "harness reset: skipping intro" << std::endl;
+    a.mBoard->mCutScene->CancelIntro();
+    pendingSeed = seed;
+    atChooser = a.mBoard->ChooseSeedsOnCurrentLevel();
+}
+std::vector<int> ChooserOffer(LawnApp& a) {
+    std::vector<int> types;
+    for (int type=0; type<SEED_IMITATER; ++type)
+        if (a.HasSeedType(static_cast<SeedType>(type))) types.push_back(type);
+    return types;
+}
+void PickSeeds(LawnApp& a, const std::vector<int>& types, int expected) {
+    // The game's own chooser clicks, then the level starts as after "Let's Rock".
+    auto& chooser = *a.mSeedChooserScreen;
+    for (int type : types) {
+        auto& seedCard = chooser.mChosenSeeds[type];
+        chooser.ClickedSeedInChooser(seedCard);
+        chooser.LandFlyingSeed(seedCard);
+    }
+    if (chooser.mSeedsInBank != expected) throw std::runtime_error("unsupported_loadout");
+    chooser.CloseSeedChooser();
+    a.mBoard->mCutScene->CancelIntro();
+    atChooser = false;
+}
+void ChooseSeeds(LawnApp& a, const std::vector<int>& types) {
+    if (!atChooser) throw std::runtime_error("not_at_seed_chooser");
+    auto offer = ChooserOffer(a);
+    size_t need = std::min<size_t>(a.mBoard->mSeedBank->mNumPackets, offer.size());
+    std::vector<int> seen;
+    for (int type : types) {
+        if (std::find(offer.begin(), offer.end(), type) == offer.end() || std::find(seen.begin(), seen.end(), type) != seen.end())
+            throw std::runtime_error("invalid_loadout");
+        seen.push_back(type);
+    }
+    if (types.size() != need) throw std::runtime_error("invalid_loadout");
+    PickSeeds(a, types, static_cast<int>(need));
+}
+void ChooserSnapshot(LawnApp& a) {
+    // Only what the chooser screen shows: the offer, the free slots and the previewed zombie types
+    // (CutScene::PlaceStreetZombies: every type in the wave list except the flag zombie), never counts or waves.
+    auto& b = *a.mBoard;
+    std::vector<int> preview;
+    for (int wave=0; wave<b.mNumWaves; ++wave)
+        for (int i=0; i<MAX_ZOMBIES_IN_WAVE; ++i) {
+            ZombieType type = b.mZombiesInWave[wave][i];
+            if (type == ZOMBIE_INVALID) break;
+            if (type != ZOMBIE_FLAG && std::find(preview.begin(), preview.end(), type) == preview.end())
+                preview.push_back(type);
+        }
+    std::sort(preview.begin(), preview.end());
+    std::ostringstream o;
+    o << "{\"ok\":true,\"chooser\":true,\"level\":" << b.mLevel << ",\"slots\":" << b.mSeedBank->mNumPackets
+      << ",\"available\":[";
+    auto offer = ChooserOffer(a);
+    for (size_t i=0; i<offer.size(); ++i) o << (i ? "," : "") << offer[i];
+    o << "],\"preview\":[";
+    for (size_t i=0; i<preview.size(); ++i) o << (i ? "," : "") << preview[i];
+    o << "]}";
+    std::cout << "PVZRPC " << o.str() << std::endl;
+}
+void FinishReset(LawnApp& a) {
+    unsigned seed = pendingSeed;
+    for (int i=0; a.mGameScene!=SCENE_PLAYING && i<3000; ++i) Tick(a);
+    if (a.mGameScene!=SCENE_PLAYING) throw std::runtime_error("intro_did_not_finish");
+    std::cerr << "harness reset: playing" << std::endl;
+    startTick = a.mBoard->mMainCounter;
+    mowerTicks.fill(-1);
+    // Resource cache warming must not change the battle's RNG stream.
+    Sexy::SRand(seed ^ 0x6d2b79f5U);
+    std::srand(seed ^ 0x6d2b79f5U);
+}
+void Reset(LawnApp& a, int level, unsigned seed) {
+    BeginReset(a, level, seed);
+    if (atChooser) {
+        // Fixed public starter loadout, no planting decisions. Same for both arms.
+        std::vector<int> types;
+        for (int type=0; type<8 && static_cast<int>(types.size())<a.mBoard->mSeedBank->mNumPackets; ++type)
+            if (a.HasSeedType(static_cast<SeedType>(type))) types.push_back(type);
+        PickSeeds(a, types, a.mBoard->mSeedBank->mNumPackets);
+    }
+    FinishReset(a);
+}
+void Render(LawnApp& a) {
+    struct RestoreRand {
+        std::string state = Sexy::HarnessSaveRand();
+        ~RestoreRand() { Sexy::HarnessRestoreRand(state); }
+    } restore;
+    Sexy::MemoryImage frame(&a);
+    frame.Create(800,600);
+    Sexy::Graphics graphics(&frame);
+    a.mBoard->Draw(&graphics);
+    auto path = std::filesystem::path(a.mCustomSaveDir) / "observation.ppm";
+    std::ofstream out(path, std::ios::binary);
+    out << "P6\n800 600\n255\n";
+    const auto* bits = frame.GetBits();
+    for (int i=0; i<800*600; ++i) {
+        char rgb[3] = {static_cast<char>(bits[i]>>16),static_cast<char>(bits[i]>>8),static_cast<char>(bits[i])};
+        out.write(rgb,3);
+    }
+    if (!out) throw std::runtime_error("frame_write_failed");
+}
+void Place(LawnApp& a,int slot,int row,int col) {
+    auto& b = *a.mBoard;
+    if (slot==-1) return;
+    if (slot<0 || slot>=b.mSeedBank->mNumPackets || row<0 || row>=5 || col<0 || col>=9)
+        throw std::runtime_error("invalid_action_bounds");
+    auto& card = b.mSeedBank->mSeedPackets[slot];
+    if (!card.CanPickUp() || b.CanPlantAt(col,row,card.mPacketType)!=PLANTING_OK)
+        throw std::runtime_error("illegal_action");
+    // Use game's ordinary click handlers, including cost/cooldown accounting.
+    card.MouseDown(0,0,1);
+    b.MouseDown(b.GridToPixelX(col,row)+40,b.GridToPixelY(col,row)+40,1);
+    bool found=false;
+    for (auto* p:b.mPlants) if (!p->mDead && p->mRow==row && p->mPlantCol==col) found=true;
+    if (!found) throw std::runtime_error("game_rejected_action");
+}
+void Dig(LawnApp& a,int row,int col) {
+    auto& b = *a.mBoard;
+    if (row<0 || row>=5 || col<0 || col>=9) throw std::runtime_error("invalid_action_bounds");
+    if (!b.mShowShovel || Done(a)) throw std::runtime_error("shovel_unavailable");
+    // The player's own sequence: pick up the shovel, click the cell; the game picks the plant it digs.
+    int x=b.GridToPixelX(col,row)+40, y=b.GridToPixelY(col,row)+40;
+    b.PickUpTool(OBJECT_TYPE_SHOVEL);
+    Plant* target=b.ToolHitTest(x,y);
+    if (!target || target->mRow!=row || target->mPlantCol!=col) {
+        b.ClearCursor();
+        throw std::runtime_error("illegal_action");
+    }
+    b.MouseDownWithTool(x,y,1,CURSOR_TYPE_SHOVEL);
+    if (!target->mDead) throw std::runtime_error("game_rejected_action");
+}
+}
+
+int RunHarness(LawnApp& a) {
+    if (a.mShutdown || a.mLoadingFailed || a.mCustomSaveDir.empty()) return 2;
+    a.mActive = true;
+    if (!a.mPlayerInfo) a.mPlayerInfo = a.mProfileMgr->AddProfile("Harness");
+    // Normally TitleScreen::Update does this before StartLoadingThread.
+    a.mMusic->MusicTitleScreenInit();
+    a.LoadingThreadProc();
+    if (a.mLoadingFailed || a.mShutdown) return 3;
+    a.mLoadingThreadCompleted = true;
+    a.mLoaded = true;
+    std::cout << "PVZRPC {\"ok\":true,\"ready\":true,\"protocol\":1}" << std::endl;
+    std::string line;
+    while (std::getline(std::cin,line)) {
+        if (line.size()>4096) return 4;
+        std::istringstream in(line);
+        std::string op; in >> op;
+        try {
+            if (op=="quit") break;
+            if (op=="reset") {
+                int level; unsigned seed;
+                if (!(in>>level>>seed)) throw std::runtime_error("invalid_reset");
+                Reset(a,level,seed);
+            } else if (op=="prepare") {
+                // Like reset, but stop at the seed chooser (when the level has one) and show the offer.
+                int level; unsigned seed;
+                if (!(in>>level>>seed)) throw std::runtime_error("invalid_reset");
+                BeginReset(a,level,seed);
+                if (atChooser) { ChooserSnapshot(a); continue; }
+                FinishReset(a);
+            } else if (op=="choose" && a.mBoard) {
+                std::vector<int> types; int type;
+                while (in>>type) types.push_back(type);
+                if (!in.eof()) throw std::runtime_error("invalid_loadout");
+                ChooseSeeds(a,types);
+                FinishReset(a);
+            } else if (op=="step" && a.mBoard) {
+                int ticks,slot,row,col;
+                if (!(in>>ticks>>slot>>row>>col) || ticks<1 || ticks>1000 || Done(a))
+                    throw std::runtime_error("invalid_step");
+                Place(a,slot,row,col);
+                for (int i=0;i<ticks && !Done(a);++i) Tick(a);
+                SDL_PumpEvents();
+            } else if (op=="dig" && a.mBoard) {
+                int row,col;
+                if (!(in>>row>>col)) throw std::runtime_error("invalid_dig");
+                Dig(a,row,col);
+            } else if (op=="render" && a.mBoard) {
+                Render(a);
+            } else if (op!="state" || !a.mBoard) throw std::runtime_error("invalid_operation");
+            Snapshot(a);
+        } catch (const std::exception& e) {
+            std::cout << "PVZRPC {\"ok\":false,\"error\":\"" << e.what() << "\"}" << std::endl;
+        }
+    }
+    a.KillBoard(); a.ProcessSafeDeleteList();
+    return 0;
+}
